# MongoDB connection string (Atlas, or mongodb://127.0.0.1:27017/wanderlust locally)
ATLASDB_URL=

# Any long random string - used to sign sessions
SECRET=

# Cloudinary (https://cloudinary.com) - image uploads
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Mapbox (https://account.mapbox.com) - geocoding and maps
MAPBOX_TOKEN=

# Gmail address and an app password (not your normal password)
EMAIL_USER=
EMAIL_PASS=
